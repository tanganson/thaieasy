{
  "metadata": {
    "id": "thai_365_communication_v1",
    "title_zh": "365 天泰語溝通訓練",
    "daily_minutes": 30,
    "learner_level": "beginner",
    "learner_language": "zh-Hant",
    "goal": "Build practical Thai communication for daily life, travel, small talk, and natural self-expression."
  },
  "daily_structure": [
    {"minutes": "0-3", "section": "warm_up_review", "title_zh": "暖身複習"},
    {"minutes": "3-10", "section": "core_sentences", "title_zh": "核心句子"},
    {"minutes": "10-18", "section": "substitution_practice", "title_zh": "替換練習"},
    {"minutes": "18-25", "section": "dialogue", "title_zh": "小對話"},
    {"minutes": "25-30", "section": "speaking_mission", "title_zh": "口說任務"}
  ],
  "content_ratio": {
    "review": 0.6,
    "new_material": 0.3,
    "challenge": 0.1
  },
  "romanization_policy": [
    {"start_day": 1, "end_day": 90, "policy": "thai_romanization_chinese_all_sentences"},
    {"start_day": 91, "end_day": 180, "policy": "thai_first_romanization_support"},
    {"start_day": 181, "end_day": 270, "policy": "romanization_for_new_or_difficult_items"},
    {"start_day": 271, "end_day": 365, "policy": "thai_first_romanization_only_when_needed"}
  ],
  "non_repetition_rules": {
    "exact_thai_sentence": "never_repeat",
    "exact_dialogue": "never_repeat",
    "exact_daily_task_days": 60,
    "main_domain": "may_repeat_only_with_new_phase_or_difficulty",
    "vocabulary": "may_repeat_in_new_context",
    "grammar_pattern": "repeat_often_with_new_vocabulary"
  },
  "spaced_review_days": [1, 3, 7, 14, 30],
  "weekly_rhythm": [
    {"day_in_week": 1, "focus": "new_scene_and_survival_phrases"},
    {"day_in_week": 2, "focus": "questions_and_answers"},
    {"day_in_week": 3, "focus": "substitution_practice"},
    {"day_in_week": 4, "focus": "short_dialogue"},
    {"day_in_week": 5, "focus": "role_play"},
    {"day_in_week": 6, "focus": "mixed_review"},
    {"day_in_week": 7, "focus": "speaking_test"}
  ],
  "phases": [
    {
      "phase": 1,
      "name": "Survival Thai",
      "days": "1-91",
      "goal": "Handle basic needs and dare to speak."
    },
    {
      "phase": 2,
      "name": "Everyday Interaction",
      "days": "92-182",
      "goal": "Handle back-and-forth daily conversations."
    },
    {
      "phase": 3,
      "name": "Small Talk and Storytelling",
      "days": "183-273",
      "goal": "Maintain 1-3 minute conversations."
    },
    {
      "phase": 4,
      "name": "Natural Communication",
      "days": "274-364",
      "goal": "Express needs, opinions, experiences, and repair communication breakdowns."
    },
    {
      "phase": 5,
      "name": "Final Assessment",
      "days": "365",
      "goal": "Complete a 10-minute practical communication simulation."
    }
  ],
  "weekly_roadmap": [
    {"week": 1, "days": "1-7", "phase": "Survival", "domain": "Greetings and politeness", "outcome": "Say hello, thank you, sorry, excuse me, and goodbye politely."},
    {"week": 2, "days": "8-14", "phase": "Survival", "domain": "Self-introduction", "outcome": "Say name, nationality, where you live, and why you learn Thai."},
    {"week": 3, "days": "15-21", "phase": "Survival", "domain": "Numbers and prices", "outcome": "Ask price, understand numbers, buy simple items."},
    {"week": 4, "days": "22-28", "phase": "Survival", "domain": "Cafe orders", "outcome": "Order coffee or tea, choose hot or iced, sweetness, takeaway."},
    {"week": 5, "days": "29-35", "phase": "Survival", "domain": "Restaurant basics", "outcome": "Ask for menu, order food, say not spicy, ask for bill."},
    {"week": 6, "days": "36-42", "phase": "Survival", "domain": "Convenience store", "outcome": "Buy items, ask for a bag, receipt, payment method."},
    {"week": 7, "days": "43-49", "phase": "Survival", "domain": "Taxi and ride-hailing", "outcome": "Say destination, turn left or right, stop here, ask how much."},
    {"week": 8, "days": "50-56", "phase": "Survival", "domain": "Directions", "outcome": "Ask where something is, understand near, far, left, and right."},
    {"week": 9, "days": "57-63", "phase": "Survival", "domain": "Time and schedule", "outcome": "Talk about today, tomorrow, yesterday, now, later, and what time."},
    {"week": 10, "days": "64-70", "phase": "Survival", "domain": "Want / do not want", "outcome": "Say what you want, do not want, need, and do not need."},
    {"week": 11, "days": "71-77", "phase": "Survival", "domain": "Have / do not have", "outcome": "Ask if someone has something; say you have or do not have it."},
    {"week": 12, "days": "78-84", "phase": "Survival", "domain": "Understanding and repair", "outcome": "Say you do not understand, ask them to repeat or speak slowly."},
    {"week": 13, "days": "85-91", "phase": "Survival", "domain": "Phase 1 integration", "outcome": "Complete mixed survival role-plays across cafe, restaurant, taxi, and shopping."},
    {"week": 14, "days": "92-98", "phase": "Everyday", "domain": "Daily routine", "outcome": "Talk about waking up, working, studying, eating, sleeping."},
    {"week": 15, "days": "99-105", "phase": "Everyday", "domain": "Work and study", "outcome": "Explain what you do, where you work, what you study."},
    {"week": 16, "days": "106-112", "phase": "Everyday", "domain": "Feelings and condition", "outcome": "Say tired, busy, happy, hungry, sick, okay, not okay."},
    {"week": 17, "days": "113-119", "phase": "Everyday", "domain": "Weather", "outcome": "Talk about hot, cold, rain, sun, and plans affected by weather."},
    {"week": 18, "days": "120-126", "phase": "Everyday", "domain": "Likes and dislikes", "outcome": "Say what you like, dislike, prefer, and why."},
    {"week": 19, "days": "127-133", "phase": "Everyday", "domain": "Family and friends", "outcome": "Talk about family members and friends simply."},
    {"week": 20, "days": "134-140", "phase": "Everyday", "domain": "Appointments", "outcome": "Make a time, change a time, say available or not available."},
    {"week": 21, "days": "141-147", "phase": "Everyday", "domain": "Hotel and accommodation", "outcome": "Check in, ask about room, wifi, key, checkout."},
    {"week": 22, "days": "148-154", "phase": "Everyday", "domain": "Market bargaining", "outcome": "Ask price, quantity, discount, size, color."},
    {"week": 23, "days": "155-161", "phase": "Everyday", "domain": "Health and pharmacy", "outcome": "Say symptoms, ask for medicine, describe pain."},
    {"week": 24, "days": "162-168", "phase": "Everyday", "domain": "Services", "outcome": "Haircut, laundry, phone shop, repair, simple requests."},
    {"week": 25, "days": "169-175", "phase": "Everyday", "domain": "Cause and result", "outcome": "Use because, so, but, although in daily explanations."},
    {"week": 26, "days": "176-182", "phase": "Everyday", "domain": "Phase 2 integration", "outcome": "Complete daily-life conversations with questions and follow-ups."},
    {"week": 27, "days": "183-189", "phase": "Small Talk", "domain": "Today and yesterday", "outcome": "Tell someone what you did today and yesterday."},
    {"week": 28, "days": "190-196", "phase": "Small Talk", "domain": "Weekend plans", "outcome": "Ask and answer about weekend plans and invitations."},
    {"week": 29, "days": "197-203", "phase": "Small Talk", "domain": "Food preferences", "outcome": "Talk about favorite foods, spicy food, drinks, restaurants."},
    {"week": 30, "days": "204-210", "phase": "Small Talk", "domain": "Hobbies", "outcome": "Talk about music, movies, exercise, coffee, travel, reading."},
    {"week": 31, "days": "211-217", "phase": "Small Talk", "domain": "Travel experiences", "outcome": "Say where you have been and what you did there."},
    {"week": 32, "days": "218-224", "phase": "Small Talk", "domain": "Places in the city", "outcome": "Talk about malls, temples, parks, cafes, markets, beaches."},
    {"week": 33, "days": "225-231", "phase": "Small Talk", "domain": "Opinions", "outcome": "Say I think, I feel, it is fun, difficult, interesting, expensive."},
    {"week": 34, "days": "232-238", "phase": "Small Talk", "domain": "Comparisons", "outcome": "Say this is better, cheaper, more delicious, closer, easier."},
    {"week": 35, "days": "239-245", "phase": "Small Talk", "domain": "Asking follow-up questions", "outcome": "Ask really, why, with whom, when, where, how was it."},
    {"week": 36, "days": "246-252", "phase": "Small Talk", "domain": "Conversation reactions", "outcome": "Use natural reactions: really, me too, I see, that's good."},
    {"week": 37, "days": "253-259", "phase": "Small Talk", "domain": "Telling a simple story", "outcome": "Tell a short story with first, then, after that, finally."},
    {"week": 38, "days": "260-266", "phase": "Small Talk", "domain": "Why learn Thai", "outcome": "Explain motivation, difficulty, progress, and goals."},
    {"week": 39, "days": "267-273", "phase": "Small Talk", "domain": "Phase 3 integration", "outcome": "Hold a 1-3 minute conversation on familiar topics."},
    {"week": 40, "days": "274-280", "phase": "Natural", "domain": "Clarifying meaning", "outcome": "Ask what does this mean, how do you say, do you mean."},
    {"week": 41, "days": "281-287", "phase": "Natural", "domain": "Correcting yourself", "outcome": "Say sorry, I said it wrong, I mean, let me say again."},
    {"week": 42, "days": "288-294", "phase": "Natural", "domain": "Asking for help", "outcome": "Ask politely for help, explanation, recommendation, and confirmation."},
    {"week": 43, "days": "295-301", "phase": "Natural", "domain": "Problem solving", "outcome": "Describe lost items, wrong order, wrong address, not working."},
    {"week": 44, "days": "302-308", "phase": "Natural", "domain": "Recommendations", "outcome": "Ask for food, place, route, product, and activity recommendations."},
    {"week": 45, "days": "309-315", "phase": "Natural", "domain": "Polite requests", "outcome": "Make softer requests and ask if something is possible."},
    {"week": 46, "days": "316-322", "phase": "Natural", "domain": "Longer descriptions", "outcome": "Describe a person, place, object, and situation in more detail."},
    {"week": 47, "days": "323-329", "phase": "Natural", "domain": "Mixed travel day", "outcome": "Combine hotel, transport, restaurant, shopping, and directions."},
    {"week": 48, "days": "330-336", "phase": "Natural", "domain": "Mixed local day", "outcome": "Combine work, cafe, errands, friends, and evening plans."},
    {"week": 49, "days": "337-343", "phase": "Natural", "domain": "Three-minute self-introduction", "outcome": "Give a structured self-introduction with reasons and preferences."},
    {"week": 50, "days": "344-350", "phase": "Natural", "domain": "Five-minute life sharing", "outcome": "Talk about daily life, learning Thai, interests, and plans."},
    {"week": 51, "days": "351-357", "phase": "Natural", "domain": "Real conversation simulations", "outcome": "Run full role-plays with unexpected questions."},
    {"week": 52, "days": "358-364", "phase": "Natural", "domain": "Final review week", "outcome": "Review all major domains and prepare final assessment."}
  ],
